# Talking Skull example configuration
# Copy to /skull.conf on the SD card or upload it from the File Manager.

# Use sta to join a 2.4 GHz network, or ap to create a skull hotspot.
wifi_mode=sta

sta_ssid=YOUR_2G_WIFI_NAME
sta_password=YOUR_WIFI_PASSWORD
sta_ip=dhcp
sta_gateway=192.168.1.1
sta_subnet=255.255.255.0

# AP settings are also used if station connection fails.
ap_ssid=TalkingSkull
ap_password=change-me-now
ap_ip=192.168.4.1
ap_gateway=192.168.4.1
ap_subnet=255.255.255.0

# Internal value 0..30. Internal 30 appears as 11 in the web UI.
volume=30
